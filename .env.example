# Telegram API — get yours at https://my.telegram.org
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_SESSION=ru_groups_session

# Storage
DB_PATH=telegram_groups.db
CSV_PATH=Telegram_groups_russia.csv
XLSX_PATH=Telegram_groups_russia.xlsx

# Scale
TARGET_GROUPS=100000
SEED_TARGET=5000

# Concurrency / rate limiting
WORKERS=8
MIN_DELAY=1.0
MAX_DELAY=3.0
MESSAGES_PER_GROUP=200
MAX_RETRIES=3

# TGStat API (опционально) — токен из https://api.tgstat.ru (платный)
TGSTAT_TOKEN=
